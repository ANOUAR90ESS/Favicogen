# Environment Variables
NODE_ENV=development

# Port the server listens on. Cloud hosts usually set this for you.
PORT=3000
HOST=0.0.0.0

# Optional: enables the AI logo generator. The app runs without it.
GEMINI_API_KEY=

# Comma-separated origins allowed to call /api/*. Leave blank to allow only
# same-origin requests.
ALLOWED_ORIGINS=
# A native build needs both of these — iOS uses capacitor://localhost and
# Android uses http://localhost, and neither is same-origin with the server:
# ALLOWED_ORIGINS=capacitor://localhost,http://localhost

# Where the native app should look for this server. Blank is correct for the
# web build, which is served by the same process that owns /api; an app bundle
# has no server behind it, so a relative path resolves to nothing. Read at
# build time by Vite, so it must be set when `npm run sync:native` runs.
VITE_API_BASE_URL=
